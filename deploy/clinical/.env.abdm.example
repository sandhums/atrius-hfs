# Clinical HFS with ABDM/NDHM profile validation — copy to `.env` and adjust.
#
# Generate a full NDHM manifest from the official NPM package:
#   cargo run -p fhir-validation --example build_ig_profile_manifest -- \
#     /path/to/ndhm/package manifests/ndhm-r4-profile-manifest.json
#
# Import terminology from the same package tree into HTS before relying on
# extensible/required ValueSet bindings in production.

HFS_SERVER_HOST=127.0.0.1
HFS_SERVER_PORT=8080
HFS_BASE_URL=http://127.0.0.1:8080
HFS_DEFAULT_FHIR_VERSION=R4

HFS_STORAGE_BACKEND=sqlite
HFS_DATABASE_URL=./data/clinical-fhir.db

# Full NDHM R4 IG (all StructureDefinitions) — set after generating manifest:
# HFS_PROFILE_MANIFEST=/absolute/path/to/ndhm-r4-profile-manifest.json
#
# CI/dev fixture manifest (NDHM Patient + AtriusPatient only):
HFS_PROFILE_MANIFEST=manifests/ndhm-r4-fixtures-manifest.json

# Locked product choice: warn on writes (log issues, still persist). Use `strict` for 422.
HFS_PROFILE_VALIDATION_MODE=warn
#
# Off by default: NDHM StructureDefinitions include a full snapshot (R4 base + constraints).
# Set true only if you also add HL7 core StructureDefinitions to the manifest and want
# strict unknown-JSON checks against the base SD (see crates/rest/src/profile_validation.rs).
HFS_PROFILE_VALIDATION_ADDONS=false

# Required for NDHM profile ValueSet binding checks ($validate and writes):
# HFS_TERMINOLOGY_SERVER=http://127.0.0.1:9091

HFS_LOG_LEVEL=info
HFS_DATA_DIR=./data
