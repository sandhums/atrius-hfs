# NDHM export validator — a dedicated HFS process, not the clinical store.
#
# Clinical HFS (deploy/env/hfs-clinical.env / .env.atrius.example) overlays
# atrius.fhir.r4.india only. Do **not** add ndhm.in to HFS_FHIR_PACKAGES there.
#
# This process seeds ndhm.in@6.5.0 so HIS export `$validate` can check remapped
# ABDM copies. HIS points HIS_NDHM_VALIDATE_URL here; clinical writes still go
# to HIS_FHIR_BASE_URL.
#
# Seed the cache:
#   ./scripts/setup-ndhm-profile-registry.sh
# Run:
#   ENV_FILE=deploy/clinical/.env.abdm.example ./scripts/run-hfs.sh
#   # or: ./scripts/run-hfs-ndhm.sh

HFS_SERVER_HOST=127.0.0.1
HFS_SERVER_PORT=8083
HFS_BASE_URL=http://127.0.0.1:8083
HFS_DEFAULT_FHIR_VERSION=R4

HFS_STORAGE_BACKEND=sqlite
HFS_DATABASE_URL=./data/ndhm-validate-fhir.db
HFS_DATA_DIR=./data

HFS_FHIR_PACKAGE_CACHE=./data/fhir-packages
HFS_FHIR_PACKAGES=ndhm.in@6.5.0
# enforce so a write to this instance (if any) also 422s; $validate always runs.
HFS_VALIDATION_MODE=enforce

# ValueSet binding checks during $validate (NDHM CS/VS live in HTS, not the schema registry)
HFS_TERMINOLOGY_SERVER=http://127.0.0.1:9091

HFS_LOG_LEVEL=info
