# Clinical HFS with Atrius IG profile validation — copy to `.env` and adjust.
#
# 1) Build Atrius IG (SUSHI) → output/ with StructureDefinition-atrius-*.json
# 2) Generate HFS profile manifest from IG output:
#      cargo run -p fhir-validation --example build_ig_profile_manifest -- \
#        /path/to/AtriusIGDraft/output \
#        manifests/atrius-r4-profile-manifest.json
# 3) HTS should have NDHM + VSAC ValueSets for binding checks (optional but recommended)

HFS_SERVER_HOST=127.0.0.1
HFS_SERVER_PORT=8082
HFS_BASE_URL=http://127.0.0.1:8082
HFS_DEFAULT_FHIR_VERSION=R4

HFS_STORAGE_BACKEND=sqlite
HFS_DATABASE_URL=./data/clinical-fhir.db

# Atrius IG StructureDefinitions (64 canonical atrius-* profiles, no output/en/ duplicates)
HFS_PROFILE_MANIFEST=manifests/atrius-r4-profile-manifest-core.json
# Full scan including en/ copies and dependency SDs (132 files):
# HFS_PROFILE_MANIFEST=manifests/atrius-r4-profile-manifest.json

# off | warn | strict — create/update call enforce_profile_on_write when manifest is set
# strict → 422 on profile errors; warn → log and still persist
HFS_PROFILE_VALIDATION_MODE=strict

HFS_PROFILE_VALIDATION_ADDONS=false

# ValueSet binding checks during $validate and writes
HFS_TERMINOLOGY_SERVER=http://127.0.0.1:9091

HFS_LOG_LEVEL=info
HFS_DATA_DIR=./data

# cr-fhir-bridge (separate process) — sidecar / cds-server hfsBaseUrl
# CR_FHIR_BRIDGE_UPSTREAM_URL=http://127.0.0.1:8082
