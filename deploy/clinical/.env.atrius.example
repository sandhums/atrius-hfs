# Clinical HFS with Atrius IG profile validation — legacy sqlite-oriented example.
#
# Prefer deploy/env/hfs-clinical.env + ./scripts/run-hfs.sh for local/dev.
# This file remains as field documentation for profile validation settings.
#
# 1) Refresh ProfileRegistry from the published IG package (recommended):
#      ./scripts/setup-atrius-profile-registry.sh
#    (fetches https://atrius.in/fhir/r4/atrius-in/package.tgz → manifests/atrius-ig-package/)
#    Or local draft: ATRIUS_IG_SOURCE=local ./scripts/build-atrius-profile-manifest.sh
# 2) HTS should have NDHM + Atrius ValueSets for binding checks (optional but recommended)

HFS_SERVER_HOST=127.0.0.1
HFS_SERVER_PORT=8082
HFS_BASE_URL=http://127.0.0.1:8082
HFS_DEFAULT_FHIR_VERSION=R4

HFS_STORAGE_BACKEND=sqlite
HFS_DATABASE_URL=./data/clinical-fhir.db

# Atrius IG StructureDefinitions (atrius-in-* + HL7 Patient extension SDs for slice validation)
HFS_PROFILE_MANIFEST=manifests/atrius-r4-profile-manifest-core.json
# Full scan including en/ copies and dependency SDs (132 files):
# HFS_PROFILE_MANIFEST=manifests/atrius-r4-profile-manifest.json

# off | warn | strict — create/update call enforce_profile_on_write when manifest is set
# strict → 422 on profile errors; warn → log and still persist
HFS_PROFILE_VALIDATION_MODE=strict

HFS_PROFILE_VALIDATION_ADDONS=false

# ValueSet binding checks during $validate and writes
HFS_TERMINOLOGY_SERVER=http://127.0.0.1:9091

HFS_LOG_LEVEL=info
HFS_DATA_DIR=./data

