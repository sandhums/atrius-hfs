[Unit]
Description=Atrius cr-fhir-bridge (Atrius to QI-Core projection proxy)
Documentation=file:///opt/atrius/share/docs/production-deployment.md
After=network-online.target atrius-hfs-clinical.service atrius-hfs-kr.service
Requires=atrius-hfs-clinical.service atrius-hfs-kr.service
Wants=network-online.target

[Service]
Type=simple
User=atrius
Group=atrius
WorkingDirectory=/opt/atrius
EnvironmentFile=-/etc/atrius/cr-fhir-bridge.env
ExecStart=/opt/atrius/bin/cr-fhir-bridge
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=atrius-clinical-reasoning.target
