# Clinical HFS (Atrius patient chart) — copy to /etc/atrius/hfs-clinical.env
#
# Seed the IG package cache before start:
#   ./scripts/setup-atrius-profile-registry.sh
# See deploy/clinical/.env.atrius.example and docs/validation-cutover.md.

HFS_SERVER_HOST=127.0.0.1
HFS_SERVER_PORT=8082
HFS_BASE_URL=http://127.0.0.1:8082
HFS_DEFAULT_FHIR_VERSION=R4

HFS_STORAGE_BACKEND=sqlite
HFS_DATABASE_URL=/opt/atrius/data/clinical-fhir.db
HFS_DATA_DIR=/opt/atrius/data

# IG profiles via helios-fhir-validator package layers.
# name@version must match the seeded cache (printed by setup-atrius-profile-registry.sh).
# Use an absolute cache path in production; for local ./scripts/run-hfs.sh prefer ./data/fhir-packages.
HFS_FHIR_PACKAGE_CACHE=/opt/atrius/data/fhir-packages
HFS_FHIR_PACKAGES=atrius.fhir.r4.india@0.1.0
HFS_VALIDATION_MODE=enforce
HFS_VALIDATION_TERMINOLOGY=tiered
HFS_VALIDATION_TERMINOLOGY_FAIL=open

# Must match HTS listen port (HTS_SERVER_PORT; Atrius default 9091).
HFS_TERMINOLOGY_SERVER=http://127.0.0.1:9091

# When using postgres-elasticsearch / sqlite-elasticsearch, set these explicitly
# (do not share the default `hfs` index prefix with another HFS process).
# HFS_ELASTICSEARCH_NODES=http://localhost:9200
# HFS_ELASTICSEARCH_INDEX_PREFIX=hfs-clinical

HFS_LOG_LEVEL=info

# Production / hardened dev — JWT validation via Keycloak JWKS (helios-auth)
# HFS_AUTH_ENABLED=true
# HFS_AUTH_JWKS_URL=https://localhost:8443/realms/fhir/protocol/openid-connect/certs
# HFS_AUTH_ISSUER=https://localhost:8443/realms/fhir
# HFS_AUTH_AUDIENCE=hfs-api
# HFS_AUTH_TENANT_CLAIM=tenant_id
# Never set HFS_AUTH_INSECURE_TLS in production.
