# Clinical HFS (Atrius patient chart) — copy to /etc/atrius/hfs-clinical.env
#
# Profile manifest and data must exist under ATRIUS_HOME before start.
# See deploy/clinical/.env.atrius.example for field descriptions.

HFS_SERVER_HOST=127.0.0.1
HFS_SERVER_PORT=8082
HFS_BASE_URL=http://127.0.0.1:8082
HFS_DEFAULT_FHIR_VERSION=R4

HFS_STORAGE_BACKEND=sqlite
HFS_DATABASE_URL=/opt/atrius/data/clinical-fhir.db
HFS_DATA_DIR=/opt/atrius/data

HFS_PROFILE_MANIFEST=/opt/atrius/manifests/atrius-r4-profile-manifest-core.json
HFS_PROFILE_VALIDATION_MODE=strict
HFS_PROFILE_VALIDATION_ADDONS=false

# Must match HTS listen port (HTS_SERVER_PORT).
HFS_TERMINOLOGY_SERVER=http://127.0.0.1:9091

HFS_LOG_LEVEL=info
