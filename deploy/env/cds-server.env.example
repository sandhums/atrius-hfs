# cds-server — copy to deploy/env/cds-server.env for local, or /etc/atrius/cds-server.env.
# Local: ./scripts/run-cds-server.sh (seeds a local env with relative manifest path if missing)
#
# CDS_HFS_BASE_URL = clinical HFS (patient chart). Includes load from CDS_LIBRARY_BASE_URL (KR).

CDS_SERVER_HOST=127.0.0.1
CDS_SERVER_PORT=8095
CDS_LOG_LEVEL=info
CDS_ENABLE_CORS=true

CDS_CLINICAL_REASONING_URL=http://127.0.0.1:8088
CDS_HFS_BASE_URL=http://127.0.0.1:8082
CDS_HTS_BASE_URL=http://127.0.0.1:9091
CDS_LIBRARY_BASE_URL=http://127.0.0.1:8079

# Local: absolute or repo-relative path. Production: /opt/atrius/manifests/...
# File path wins over KR Binary when set.
CDS_SERVICES_MANIFEST_PATH=./manifests/cds-services-kr.json

# Optional: load catalog from KR Binary instead of local JSON (omit when using file path)
# CDS_KR_SERVICES_BINARY_ID=cds-services-catalog

CDS_SIDECAR_TIMEOUT_SECS=120

# Local: leave false until pins are validated. Production: true.
CDS_REQUIRE_LIBRARY_VERSION=false
CDS_VALIDATE_KR_LIBRARIES=false

# Production SMART: require CDS client fhirAuthorization on every invoke
# CDS_REQUIRE_FHIR_AUTHORIZATION=true
# CDS_FHIR_SERVER_ALLOWLIST=ehr.example.com,fhir.mytenant.example.com

# Dev-only fallback when hook context omits measurementPeriod (omit in production)
# CDS_MEASUREMENT_PERIOD_LOW=2026-01-01
# CDS_MEASUREMENT_PERIOD_HIGH=2026-12-31

# Critical-labs rest-hook → Flag persistence (POST /internal/cds/fhir-notifications).
# BASE_URL enables writes; with HFS auth use client-credentials (preferred) or a static bearer.
CDS_FEEDBACK_FHIR_BASE_URL=http://127.0.0.1:8082
CDS_FEEDBACK_FHIR_TENANT_ID=atrius-hospitals
CDS_FEEDBACK_OAUTH_TOKEN_URL=https://localhost:8443/realms/fhir/protocol/openid-connect/token
CDS_FEEDBACK_OAUTH_CLIENT_ID=cds-backend-client
CDS_FEEDBACK_OAUTH_CLIENT_SECRET=cds-backend-secret
# Local Keycloak self-signed cert only — leave false in production:
CDS_FEEDBACK_OAUTH_TLS_INSECURE=true
# Optional override (expires ~300s); wins over OAuth when set:
# CDS_FEEDBACK_FHIR_BEARER_TOKEN=
# CDS_SUBSCRIPTION_WEBHOOK_SECRET=
