# cds-server — copy to /etc/atrius/cds-server.env
#
# CDS_HFS_BASE_URL must be cr-fhir-bridge (8081), not clinical HFS (8082).

CDS_SERVER_HOST=127.0.0.1
CDS_SERVER_PORT=8095
CDS_LOG_LEVEL=info
CDS_ENABLE_CORS=true

CDS_CLINICAL_REASONING_URL=http://127.0.0.1:8088
CDS_HFS_BASE_URL=http://127.0.0.1:8081
CDS_HTS_BASE_URL=http://127.0.0.1:9091
CDS_LIBRARY_BASE_URL=http://127.0.0.1:8079

CDS_SERVICES_MANIFEST_PATH=/opt/atrius/manifests/cds-services-kr-ecqm.json

# Optional: load catalog from KR Binary instead of local JSON
CDS_KR_SERVICES_BINARY_ID=cds-services-catalog

CDS_SIDECAR_TIMEOUT_SECS=120

# Production: pin KR library versions in manifest and probe KR at startup
CDS_REQUIRE_LIBRARY_VERSION=true
CDS_VALIDATE_KR_LIBRARIES=true

# Production SMART: require CDS client fhirAuthorization on every invoke
# CDS_REQUIRE_FHIR_AUTHORIZATION=true
# Comma-separated allowed fhirServer hosts (when fhirAuthorization present)
# CDS_FHIR_SERVER_ALLOWLIST=ehr.example.com,fhir.mytenant.example.com

# Dev-only fallback when hook context omits measurementPeriod (omit in production)
# CDS_MEASUREMENT_PERIOD_LOW=2026-01-01
# CDS_MEASUREMENT_PERIOD_HIGH=2026-12-31
