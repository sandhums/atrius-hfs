# cr-fhir-bridge — copy to /etc/atrius/cr-fhir-bridge.env
#
# Sidecar and cds-server must use CDS_HFS_BASE_URL = bridge (this service), not clinical HFS.

CR_FHIR_BRIDGE_HOST=127.0.0.1
CR_FHIR_BRIDGE_PORT=8081
CR_FHIR_BRIDGE_LOG_LEVEL=info

CR_FHIR_BRIDGE_UPSTREAM_URL=http://127.0.0.1:8082
CR_FHIR_BRIDGE_KR_URL=http://127.0.0.1:8079

# Optional: custom mapper manifest JSON (built-in v0.1 when unset)
# ATRIUS_MAPPER_MANIFEST=/opt/atrius/manifests/atrius-mapper-v0.1.json

CR_FHIR_BRIDGE_ENABLE_CORS=true
CR_FHIR_BRIDGE_REQUEST_TIMEOUT=30
CR_FHIR_BRIDGE_MAX_BODY_SIZE=10485760

# Match clinical HFS HFS_DEFAULT_TENANT so sidecar/CDS requests without X-Tenant-ID resolve chart data.
CR_FHIR_BRIDGE_DEFAULT_TENANT=atrius-hospitals
