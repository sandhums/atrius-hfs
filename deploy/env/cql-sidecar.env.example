# JVM CQL sidecar — copy to deploy/env/cql-sidecar.env (local) or /etc/atrius/cql-sidecar.env.
# Local: ./scripts/run-cql-sidecar.sh
#
# Prefer SIDECAR_JAR when you have a packaged jar; otherwise set JVMSIDECAR_HOME
# to the Maven project (default ~/IdeaProjects/JVMsidecar).

SIDECAR_PORT=8088

# Path to fat/uber jar from: cd $JVMSIDECAR_HOME && mvn -q package -DskipTests
# SIDECAR_JAR=/opt/atrius/lib/cql-sidecar.jar

# Local Maven project (used when SIDECAR_JAR is unset)
# JVMSIDECAR_HOME=/Users/sandhu/IdeaProjects/JVMsidecar

# JVM heap; adjust for concurrent evaluate load
JAVA_OPTS=-Xmx1024m

# Protect POST /v1/admin/cache/libraries/clear (omit for local dev)
# SIDECAR_ADMIN_TOKEN=change-me-in-production

# Debug only — verbose FHIR HTTP logging (disable in production)
# SIDECAR_FHIR_HTTP_LOG=false
