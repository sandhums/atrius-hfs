# JVM CQL sidecar (external JVMsidecar build) — copy to /etc/atrius/cql-sidecar.env
#
# Build jar in JVMsidecar repo, then install to SIDECAR_JAR (see production-deployment.md).

SIDECAR_PORT=8088

# Path to fat/uber jar from: mvn -q package -DskipTests
SIDECAR_JAR=/opt/atrius/lib/cql-sidecar.jar

# JVM heap; adjust for concurrent evaluate load
JAVA_OPTS=-Xmx1024m

# Protect POST /v1/admin/cache/libraries/clear (omit for local dev)
# SIDECAR_ADMIN_TOKEN=change-me-in-production

# Debug only — verbose FHIR HTTP logging (disable in production)
# SIDECAR_FHIR_HTTP_LOG=false
