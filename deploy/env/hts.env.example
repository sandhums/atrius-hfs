# HTS — copy to /etc/atrius/hts.env (not committed).
# Install: deploy/systemd/install.sh
#
# Terminology must be imported before first production use:
#   hts import ... --database-url /opt/atrius/data/hts.db

HTS_SERVER_HOST=127.0.0.1
HTS_SERVER_PORT=9091
HTS_LOG_LEVEL=info

HTS_STORAGE_BACKEND=sqlite
HTS_DATABASE_URL=/opt/atrius/data/hts.db

HTS_ENABLE_CORS=true
HTS_CORS_ORIGINS=*

# Optional: auto-import on empty DB (directory of .tgz / RF2 / etc.)
# HTS_BOOTSTRAP_DIR=/opt/atrius/terminology-data
