# HTS — copy to deploy/env/hts.env for local, or /etc/atrius/hts.env for production.
# Local: ./scripts/run-hts.sh (auto-creates hts.env with ./data/hts.db if missing)
# Install: deploy/systemd/install.sh
#
# Terminology must be imported before first use:
#   ./target/release/hts import ./crates/hts/terminology-data --database-url ./data/hts.db

HTS_SERVER_HOST=127.0.0.1
HTS_SERVER_PORT=9091
HTS_LOG_LEVEL=info

HTS_STORAGE_BACKEND=sqlite
# Local default (run-hts.sh rewrites /opt path when seeding hts.env):
HTS_DATABASE_URL=./data/hts.db

HTS_ENABLE_CORS=true
HTS_CORS_ORIGINS=*

# Optional: auto-import on empty DB (directory of .tgz / RF2 / etc.)
# HTS_BOOTSTRAP_DIR=./crates/hts/terminology-data
