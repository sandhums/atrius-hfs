# Knowledge Repository HFS — copy to /etc/atrius/hfs-kr.env
#
# eCQM Library resources imported to HFS_DATABASE_URL before sidecar/cds-server use.

HFS_SERVER_HOST=127.0.0.1
HFS_SERVER_PORT=8079
HFS_BASE_URL=http://127.0.0.1:8079

HFS_STORAGE_BACKEND=postgres
HFS_DATABASE_URL=postgresql://sandhu:parsons02@localhost:5432/fhir_kr

HFS_TERMINOLOGY_SERVER=http://localhost:9091

HFS_AUTH_ENABLED=false
HFS_DEFAULT_TENANT=default
HFS_TENANT_ROUTING_MODE=header_only

HFS_LOG_LEVEL=info
