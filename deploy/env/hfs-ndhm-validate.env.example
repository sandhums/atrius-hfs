# Dedicated NDHM/ABDM export validator HFS — copy to hfs-ndhm-validate.env.
# Same contract as deploy/clinical/.env.abdm.example.
#
#   ./scripts/setup-ndhm-profile-registry.sh
#   ./scripts/run-hfs-ndhm.sh
#
# HIS: HIS_NDHM_VALIDATE_URL=http://127.0.0.1:8083
# Clinical HFS stays on :8082 with atrius.fhir.r4.india only.

HFS_SERVER_HOST=127.0.0.1
HFS_SERVER_PORT=8083
HFS_BASE_URL=http://127.0.0.1:8083
HFS_DEFAULT_FHIR_VERSION=R4

HFS_STORAGE_BACKEND=sqlite
HFS_DATABASE_URL=/opt/atrius/data/ndhm-validate-fhir.db
HFS_DATA_DIR=/opt/atrius/data

HFS_FHIR_PACKAGE_CACHE=/opt/atrius/data/fhir-packages
HFS_FHIR_PACKAGES=ndhm.in@6.5.0
HFS_VALIDATION_MODE=enforce
HFS_VALIDATION_TERMINOLOGY=tiered
HFS_VALIDATION_TERMINOLOGY_FAIL=open

HFS_TERMINOLOGY_SERVER=http://127.0.0.1:9091

HFS_LOG_LEVEL=info
