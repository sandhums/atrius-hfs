# Knowledge Repository HFS — copy to `.env.kr` and adjust (see comments).
# Local overrides only; not committed (see root `.gitignore`).

# --- Identity / listen ---
HFS_SERVER_HOST=127.0.0.1
HFS_SERVER_PORT=8079
HFS_BASE_URL=http://127.0.0.1:8079

# --- Persistence (dedicated KR DB; path is relative to cwd when using SQLite file) ---
HFS_STORAGE_BACKEND=sqlite
HFS_DATABASE_URL=./data/kr-fhir.db

# Optional: CR IG profiles for artifact validation (generate/register separately)
# HFS_PROFILE_MANIFEST=/path/to/profile-manifest.json

# --- KR-oriented defaults (no JWT on this host; lock down with network/gateway) ---
HFS_AUTH_ENABLED=false

# Single-catalog semantics; knowledge resources are Shared in DefaultResourceTenancy.
HFS_DEFAULT_TENANT=default
HFS_TENANT_ROUTING_MODE=header_only

# Optional: delegate terminology if KR validation/search needs ValueSet expansion on-server
# HFS_TERMINOLOGY_SERVER=http://127.0.0.1:8090

HFS_LOG_LEVEL=info
HFS_DATA_DIR=./data
