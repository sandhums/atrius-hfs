      "id": "er-chest-pain-pathway",
      "hook": "encounter-start",
      "title": "Emergency Department Chest Pain Pathway",
      "description": "Person presenting to the emergency department with chest pain: initial clinical assessment, classification into ACS / other cardiac / non-cardiac / other causes, then branch-specific management. ACS branch includes ECG, troponin, aspirin, and cardiology consult.",
      "prefetch": {
        "patient": "Patient/{{context.patientId}}",
        "encounters": "Encounter?patient={{context.patientId}}",
        "conditions": "Condition?patient={{context.patientId}}",
        "observations": "Observation?patient={{context.patientId}}",
        "questionnaireResponses": "QuestionnaireResponse?patient={{context.patientId}}",
        "serviceRequests": "ServiceRequest?patient={{context.patientId}}",
        "medicationRequests": "MedicationRequest?patient={{context.patientId}}",
        "diagnosticReports": "DiagnosticReport?patient={{context.patientId}}",
        "medicationAdministrations": "MedicationAdministration?patient={{context.patientId}}"
      },
      "libraryId": "AtriusERChestPainPathway",
      "libraryVersion": "0.4.2",
      "expression": "In Scope",
      "resolveFromFhir": true,
      "cdsHooksVersion": "1.0",
      "planDefinitionId": "er-chest-pain-pathway",
      "planDefinitionUrl": "https://atrius.in/fhir/r4/atrius-in/PlanDefinition/er-chest-pain-pathway"
    },
