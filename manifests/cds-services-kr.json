{
  "services": [
    {
      "id": "atrius-critical-labs",
      "hook": "patient-view",
      "title": "Critical Lab Value Alerts",
      "description": "Interruptive alerts when the most recent resulted potassium, sodium, glucose, or cardiac troponin crosses a critical threshold. Each alert proposes an immediate clinician review task and a confirmatory repeat sample.",
      "prefetch": {
        "patient": "Patient/{{context.patientId}}",
        "observations": "Observation?patient={{context.patientId}}"
      },
      "libraryId": "AtriusCriticalLabs",
      "libraryVersion": "0.1.0",
      "expression": "Has Critical Lab Value",
      "resolveFromFhir": true,
      "cdsHooksVersion": "1.0",
      "planDefinitionId": "atrius-critical-labs",
      "planDefinitionUrl": "https://atrius.in/fhir/r4/atrius-in/PlanDefinition/atrius-critical-labs"
    },
    {
      "id": "atrius-ddi-check",
      "hook": "order-sign",
      "title": "Drug-Drug Interaction Check",
      "description": "Interruptive alerts at order signing when a draft medication order interacts with an active prescription: statin + CYP3A4-inhibiting macrolide (rhabdomyolysis), warfarin + NSAID (bleeding), ACE inhibitor + potassium-sparing diuretic (hyperkalemia). Cards propose safer alternatives or monitoring.",
      "prefetch": {
        "patient": "Patient/{{context.patientId}}",
        "medicationRequests": "MedicationRequest?patient={{context.patientId}}"
      },
      "libraryId": "AtriusDrugInteractions",
      "libraryVersion": "0.1.0",
      "expression": "Has Drug Interaction",
      "resolveFromFhir": true,
      "cdsHooksVersion": "1.0",
      "planDefinitionId": "atrius-ddi-check",
      "planDefinitionUrl": "https://atrius.in/fhir/r4/atrius-in/PlanDefinition/atrius-ddi-check"
    },
    {
      "id": "atrius-imaging-appropriateness",
      "hook": "order-select",
      "title": "Imaging Appropriateness (Lumbar MRI)",
      "description": "When a lumbar spine MRI is selected for a patient whose low back pain began within 6 weeks and who has no red-flag condition (cauda equina, malignancy), advise conservative therapy first and propose a plain lumbar radiograph when imaging is required.",
      "prefetch": {
        "patient": "Patient/{{context.patientId}}",
        "conditions": "Condition?patient={{context.patientId}}",
        "serviceRequests": "ServiceRequest?patient={{context.patientId}}"
      },
      "libraryId": "AtriusImagingAppropriateness",
      "libraryVersion": "0.1.0",
      "expression": "Early Lumbar MRI Without Red Flags",
      "resolveFromFhir": true,
      "cdsHooksVersion": "1.0",
      "planDefinitionId": "atrius-imaging-appropriateness",
      "planDefinitionUrl": "https://atrius.in/fhir/r4/atrius-in/PlanDefinition/atrius-imaging-appropriateness"
    },
    {
      "id": "atrius-preventive-care",
      "hook": "patient-view",
      "title": "Preventive Care Reminders",
      "description": "Non-interruptive reminders when preventive care is due: colorectal cancer screening (age 45–75, no colonoscopy in 10 years and no FIT/FOBT in 1 year) and seasonal influenza vaccination (adult, none in the last 12 months).",
      "prefetch": {
        "patient": "Patient/{{context.patientId}}",
        "procedures": "Procedure?patient={{context.patientId}}",
        "observations": "Observation?patient={{context.patientId}}",
        "immunizations": "Immunization?patient={{context.patientId}}"
      },
      "libraryId": "AtriusPreventiveCare",
      "libraryVersion": "0.1.0",
      "expression": "Preventive Care Reminder Needed",
      "resolveFromFhir": true,
      "cdsHooksVersion": "1.0",
      "planDefinitionId": "atrius-preventive-care",
      "planDefinitionUrl": "https://atrius.in/fhir/r4/atrius-in/PlanDefinition/atrius-preventive-care"
    },
    {
      "id": "atrius-renal-dosing",
      "hook": "order-sign",
      "title": "Renal Dosing Check",
      "description": "At order signing, compare draft metformin and gabapentin orders against the most recent eGFR (last 12 months): metformin is contraindicated below eGFR 30 and dose-limited at 30-45; gabapentin is dose-banded below 60. Replacement orders carry the renally-adjusted dose via dynamicValue.",
      "prefetch": {
        "patient": "Patient/{{context.patientId}}",
        "observations": "Observation?patient={{context.patientId}}",
        "medicationRequests": "MedicationRequest?patient={{context.patientId}}"
      },
      "libraryId": "AtriusRenalDosing",
      "libraryVersion": "0.1.0",
      "expression": "Renal Dose Adjustment Needed",
      "resolveFromFhir": true,
      "cdsHooksVersion": "1.0",
      "planDefinitionId": "atrius-renal-dosing",
      "planDefinitionUrl": "https://atrius.in/fhir/r4/atrius-in/PlanDefinition/atrius-renal-dosing"
    },
