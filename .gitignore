.DS_Store
/target
/node_modules
yarn.lock
crates/sof/test_report.json
crates/sof/output.csv
.idea
package-lock.json
.prettierrc
off
# Build script download markers
.download_marker

# SQLite database files
*.db
*.db-shm
*.db-wal

# Test artifacts
/test-artifacts

/crates/fhir/tests/
/crates/hts/terminology-data/
/crates/hts/data/
/deploy/kr/.env.kr

# Expanded Atrius IG package (regenerate via ./scripts/setup-atrius-profile-registry.sh)
/manifests/atrius-ig-package/
/manifests/atrius-ig-package.tgz
.cache/

# Local service env (secrets) — keep only *.env.example in git
deploy/env/*.env
!deploy/env/*.env.example
.env

# Local audit sink dumps (runtime; may contain PHI)
/data/audit*.ndjson

# Seeded FHIR NPM package cache (./scripts/setup-atrius-profile-registry.sh)
/data/fhir-packages/

# Runtime + build logs (hts-*.log, hts-run.log, test-*.log, compile.log, …)
*.log

# Python bytecode (e.g. audit test helpers under crates/hfs/tests/audit)
__pycache__/
*.pyc
/.claude/skills/frontend-design/
/.agents/skills/frontend-design/
/.vscode/

# Local working notes, plans and scratch documents. Kept out of the repo on
# purpose: they are personal working material, not project documentation, and
# they should never reach a PR. `tmp/` is the intended home for them.
/tmp/
